# Local PostgreSQL connection string. On Render / production, use the platform database URL.
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/college_cms

# Generate a long random value (32+ characters); never commit the real value.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Frontend origin(s) allowed by CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=5000

# Required for real password-reset email delivery (Resend)
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://localhost:5173

# Shared API gateway base URL (required for real cross-module calls)
# Example: https://college-gateway.onrender.com
GATEWAY_URL=

# Optional path overrides per partner module (defaults are listed)
# GATEWAY_LIBRARY_PATH=/api/v1/library/summary
# GATEWAY_REGISTRAR_PATH=/api/v1/registrar/me
# GATEWAY_STUDENT_PORTAL_PATH=/api/v1/student/summary
# GATEWAY_FINANCE_PATH=/api/v1/finance/summary
# GATEWAY_FACULTY_PATH=/api/v1/faculty/summary
# GATEWAY_CLINIC_PATH=/api/v1/clinic/summary
# GATEWAY_INVENTORY_PATH=/api/v1/inventory/summary
